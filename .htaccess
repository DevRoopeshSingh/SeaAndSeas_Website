# Sea & Seas Shipping Private Limited - Plesk Apache / Nginx Configuration
DirectoryIndex index.html

# Prevent Directory Browsing
Options -Indexes

# UTF-8 Encoding
AddDefaultCharset UTF-8

# Block direct HTTP access to internal script and library directories
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule (^|/)\. - [F,L]
RewriteRule ^(includes|phpmailer|lib|data|storage|uploads|applications_archive|tests|test-output|scratch|scripts|migrations|docs|node_modules)(/.*)?$ - [F,L,NC]
RewriteRule ^(NEW.*\.docx|server\.js|package(-lock)?\.json|test-mail\.php)$ - [F,L,NC]
RewriteRule ^apply/?$ apply.html [L]
RewriteRule ^admin/?$ admin.html [L]
RewriteRule ^api/(.*)$ api.php?route=$1 [QSA,L]
</IfModule>

# Block access to sensitive data and config files
<FilesMatch "(^|/)(\.env.*|applications_roster\.json|package.*\.json|server\.js|\.git.*|\.DS_Store|.*\.log|.*\.zip|.*\.sqlite.*|.*\.db.*|.*\.sql)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Leverage Browser Caching for Fast Performance
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Enable Gzip / Deflate Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
