<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- 
      Plesk for Windows (IIS 10.0) Safe Configuration
      Note: <security>, <requestFiltering>, and <customHeaders> are locked 
      at the server/parent level in PleskWin and will cause HTTP 500.19 if specified here.
    -->
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>
    <!-- Requires IIS URL Rewrite. Ask the host to enable/unlock rewrite first. -->
    <rewrite>
      <rules>
        <rule name="Block application internals" stopProcessing="true">
          <match url="(^|/)\.|^(includes|phpmailer|lib|data|storage|uploads|applications_archive|tests|scripts|migrations|docs|node_modules)(/|$)|^(NEW.*\.docx|server\.js|package(-lock)?\.json|test-mail\.php)$|\.(sql|sqlite.*|db.*|log|zip)$" ignoreCase="true" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
        </rule>
        <rule name="Applicant form" stopProcessing="true">
          <match url="^apply/?$" /><action type="Rewrite" url="apply.html" />
        </rule>
        <rule name="Staff portal" stopProcessing="true">
          <match url="^admin/?$" /><action type="Rewrite" url="admin.html" />
        </rule>
        <rule name="Application staff API" stopProcessing="true">
          <match url="^api/(.*)$" /><action type="Rewrite" url="api.php?route={R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
