# ==============================================================================
# Sea & Seas Shipping Private Limited - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in your project root or (recommended for Plesk hosting)
# place it one level above httpdocs (e.g., /var/www/vhosts/yourdomain.com/.env).
#
# IMPORTANT SECURITY RULES:
# 1. Never commit real credentials, passwords, or production .env files to Git.
# 2. Restrict file permissions on the server: chmod 600 .env
# 3. Only the first readable .env is loaded; variables are not merged across files.
# 4. System / environment variables (CLI / OS) take precedence over .env entries.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Environment
# ------------------------------------------------------------------------------
# Set to 'local' for localhost HTTP development (e.g., http://127.0.0.1:8000).
# Set to 'production' for live hosting. Requires HTTPS; enables Secure session cookies.
APP_ENV=production

# ------------------------------------------------------------------------------
# 2. Private Storage (Seafarer Applications & Admin Portal)
# ------------------------------------------------------------------------------
# CRITICAL: Absolute filesystem path outside the web document root (httpdocs / public_html).
# PHP must have read/write access (0700). Include this path in PHP open_basedir if enabled.
# The system stores:
#   - SQLite database (applications.sqlite)
#   - Uploaded seafarer CV files (files/<hash>/cv.*)
#   - Generated Form RPS 01-A Word documents (files/<hash>/application.docx)
#   - Protected staff login sessions (sessions/)
#
# Examples:
#   Linux / Plesk:   /var/www/vhosts/YOUR_DOMAIN/seaandseas-private
#   Windows / IIS:   D:/private/seaandseas
#   Local (macOS):   /tmp/seaandseas-local
APPLICATION_PRIVATE_DIR=REPLACE_WITH_ABSOLUTE_PRIVATE_STORAGE_PATH

# ------------------------------------------------------------------------------
# 3. Crewing Desk Staff Admin Portal Credentials (/admin)
# ------------------------------------------------------------------------------
# Staff portal username (e.g., admin, crewing)
ADMIN_USERNAME=admin

# Staff portal password hash.
# DO NOT put plain text passwords here. Generate a secure PHP bcrypt hash:
#   php -r 'echo password_hash(readline("Staff password: "), PASSWORD_DEFAULT), PHP_EOL;'
#
# Enclose the hash in single quotes ('...') to protect '$' symbols from variable interpolation.
# Example format: '$2y$12$e8...'
ADMIN_PASSWORD_HASH='REPLACE_WITH_GENERATED_PHP_PASSWORD_HASH'

# ------------------------------------------------------------------------------
# 4. Mail Delivery & SMTP Configuration (PHPMailer)
# ------------------------------------------------------------------------------
# Mail transport driver: 'smtp' (recommended) or 'mail' (PHP internal mail function)
MAIL_MAILER=smtp

# SMTP Server hostname (e.g., mail.accu20.com, smtp-relay.brevo.com, smtp.gmail.com)
MAIL_HOST=mail.accu20.com

# SMTP Port:
#   587 - Standard for TLS / STARTTLS (recommended)
#   465 - Standard for SSL / SMTPS
#   25  - Unencrypted / relay (rarely used)
MAIL_PORT=587

# Encryption protocol: 'tls' (for port 587), 'ssl' (for port 465), or 'none'
MAIL_ENCRYPTION=tls

# SMTP Authentication credentials
MAIL_USERNAME=website@seasshipping.com
MAIL_PASSWORD=your_actual_mailbox_password_here

# Outgoing "From" email headers
MAIL_FROM_ADDRESS=website@seasshipping.com
MAIL_FROM_NAME="Sea & Seas – Website"

# Website form submission destination (inbox where inquiries & quick CVs are received)
FORM_SUBMISSION_TO=ohmeujjawal@gmail.com

# Reply-To email address presented to recipients
MAIL_REPLY_TO=crewing@seasshipping.com

# ------------------------------------------------------------------------------
# 5. Background Application Notification Worker
# ------------------------------------------------------------------------------
# When enabled ('true'), a notification is queued for each completed RPS 01-A application.
# Requires scheduling the CLI worker on your server via cron:
#   */5 * * * * php /ABSOLUTE_PATH/scripts/send-application-notifications.php
# Note: Staff notifications contain only the application reference number; no sensitive
# applicant bio-data or CV files are transmitted via email for privacy protection.
APPLICATION_EMAIL_ENABLED=false

# ------------------------------------------------------------------------------
# 6. Mail Diagnostic Tool Security (test-mail.php)
# ------------------------------------------------------------------------------
# Secret access key for the SMTP diagnostic test page (https://seasshipping.com/test-mail.php?key=seas2026).
# Protects against unauthorized SMTP testing or crawler access.
# Change to a private, unpredictable string in production.
DIAGNOSTIC_KEY=seas2026
