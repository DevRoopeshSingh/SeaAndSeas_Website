# ==============================================================================
# Sea & Seas Shipping - SMTP Configuration (.env.example)
# ==============================================================================
MAIL_HOST=mail.accu20.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls

MAIL_USERNAME=website@seasshipping.com
MAIL_PASSWORD=your_actual_mailbox_password_here

MAIL_FROM_ADDRESS=website@seasshipping.com
MAIL_FROM_NAME="Sea & Seas – Website"

FORM_SUBMISSION_TO=ohmeujjawal@gmail.com
MAIL_REPLY_TO=crewing@seasshipping.com

# ==============================================================================
# Crewing Desk Staff Admin Portal Credentials
# ==============================================================================
APP_ENV=production
# Required: outside httpdocs/document root, writable only by the site's PHP user.
APPLICATION_PRIVATE_DIR=/var/www/vhosts/example.com/seaandseas-private
ADMIN_USERNAME=crewing
# Generate with: php -r 'echo password_hash(readline("Staff password: "), PASSWORD_DEFAULT), PHP_EOL;'
ADMIN_PASSWORD_HASH=replace_with_generated_password_hash
# Optional staff notification queue. Schedule the CLI worker; no dossier is emailed.
APPLICATION_EMAIL_ENABLED=false
