# ==============================================================================
# Sea & Seas Shipping - SMTP Configuration (.env)
# ==============================================================================
# Instructions:
# 1. On your live Plesk server, copy this file to `.env` in your httpdocs folder.
# 2. Fill in your actual mailbox password in MAIL_PASSWORD.
# 3. Never commit your `.env` file to Git or public repositories.
# ==============================================================================

# Outgoing SMTP Mail Server
MAIL_HOST=cp1.accu20.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl

# SMTP Authentication Credentials
MAIL_USERNAME=website@seasshipping.com
MAIL_PASSWORD=your_actual_mailbox_password_here

# Sender Identity (Must match your authenticated domain mailbox)
MAIL_FROM_ADDRESS=website@seasshipping.com
MAIL_FROM_NAME="Sea & Seas – Website"

# Destination Mailbox for Seafarer Applications & Inquiries
FORM_SUBMISSION_TO=ohmeujjawal@gmail.com

# Optional Default Reply-To (if applicant email is not provided)
MAIL_REPLY_TO=crewing@seasshipping.com
